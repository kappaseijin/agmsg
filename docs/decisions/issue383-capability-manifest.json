    "message-send-v1": {"argv": ["message-send", "<team>", "<from>", "<recipient>", "<requestId>", "<body>"], "success": ["messageId", "requestId", "state=queued"], "failure": ["unknown"]},
    "handoff-receipt-v1": {"argv": ["handoff-receipt", "<team>", "<inputMessageId>", "<requestId>", "<delegateMessageId>"], "success": ["inputMessageId", "requestId", "delegateMessageId", "receiptId", "state=recorded"], "failure": ["unknown", "id_mismatch"]}
