{
  "providerCommit": "0b2117c5f91f7950cc196e52edb188748adfa50a",
  "schemaVersion": 1,
  "command": "scripts/p2-provider.sh",
  "requiredCapabilities": [
    "message-peek-v1",
    "message-claim-v1",
    "message-release-v1",
    "message-ack-v1",
    "message-send-v1",
    "handoff-receipt-v1"
  ],
  "notUsedCapabilities": [
    "history"
  ],
  "capabilities": {
    "message-peek-v1": {
      "argv": [
        "message-peek",
        "<team>",
        "<recipient>"
      ],
      "ids": [
        "messageId"
      ],
      "success": [
        "state=ok",
        "messageId",
        "from",
        "to",
        "body",
        "createdAt"
      ],
      "failure": [
        "absent",
        "unknown"
      ],
      "exitStatus": {
        "json": 0,
        "error": [
          1,
          2
        ]
      }
    },
    "message-claim-v1": {
      "argv": [
        "message-claim",
        "<team>",
        "<messageId>",
        "<owner>"
      ],
      "ids": [
        "messageId",
        "owner"
      ],
      "success": [
        "state=claimed",
        "messageId",
        "owner"
      ],
      "failure": [
        "unknown",
        "busy"
      ],
      "exitStatus": {
        "json": 0,
        "error": [
          1,
          2
        ]
      }
    },
    "message-release-v1": {
      "argv": [
        "message-release",
        "<team>",
        "<messageId>",
        "<owner>"
      ],
      "ids": [
        "messageId",
        "owner"
      ],
      "success": [
        "state=released",
        "messageId",
        "owner"
      ],
      "failure": [
        "unknown",
        "owner_mismatch"
      ],
      "exitStatus": {
        "json": 0,
        "error": [
          1,
          2
        ]
      }
    },
    "message-ack-v1": {
      "argv": [
        "message-ack",
        "<team>",
        "<messageId>",
        "<owner>",
        "<receiptId>"
      ],
      "ids": [
        "messageId",
        "owner",
        "receiptId"
      ],
      "success": [
        "state=acked",
        "messageId",
        "owner",
        "receiptId"
      ],
      "failure": [
        "unknown",
        "receipt_missing"
      ],
      "exitStatus": {
        "json": 0,
        "error": [
          1,
          2
        ]
      }
    },
    "message-send-v1": {
      "argv": [
        "message-send",
        "<team>",
        "<from>",
        "<recipient>",
        "<requestId>",
        "<body>"
      ],
      "ids": [
        "messageId",
        "requestId"
      ],
      "success": [
        "state=queued",
        "messageId",
        "requestId",
        "team",
        "from",
        "to"
      ],
      "failure": [
        "unknown"
      ],
      "exitStatus": {
        "json": 0,
        "error": [
          1,
          2
        ]
      }
    },
    "handoff-receipt-v1": {
      "argv": [
        "handoff-receipt",
        "<team>",
        "<inputMessageId>",
        "<requestId>",
        "<delegateMessageId>"
      ],
      "ids": [
        "inputMessageId",
        "requestId",
        "delegateMessageId",
        "receiptId"
      ],
      "success": [
        "state=recorded",
        "inputMessageId",
        "requestId",
        "delegateMessageId",
        "receiptId",
        "team"
      ],
      "failure": [
        "unknown",
        "id_mismatch"
      ],
      "exitStatus": {
        "json": 0,
        "error": [
          1,
          2
        ]
      }
    }
  }
}
