diff --git a/scripts/lib/actas-lock.sh b/scripts/lib/actas-lock.sh
--- a/scripts/lib/actas-lock.sh
+++ b/scripts/lib/actas-lock.sh
@@ -229 +229,2 @@ actas_lock_gc_stale() {
-# Echoes one of: free | mine | other:<sid>
+# Echoes one of: free | mine | other:<sid>. An existing lock whose owner
+# cannot be read is reported as unknown on stdout and returns non-zero.
@@ -232,2 +233,22 @@ actas_lock_state() {
-  local owner
-  owner="$(actas_lock_owner "$team" "$agent")"
+  local lock owner
+  lock="$(actas_lock_path "$team" "$agent")"
+  if owner="$(actas_lock_owner "$team" "$agent")"; then
+    :
+  elif [ -f "$lock" ]; then
+    # An unreadable lock that is still present is not permission to clean up.
+    printf 'unknown\n'
+    return 1
+  else
+    # The watcher can remove the lock after actas_lock_owner's initial
+    # existence check but before its read. A lock that is gone now is a real
+    # free state, not an unreadable owner; treating that narrow race as unknown
+    # makes graceful despawn fail exactly while its target is tearing down.
+    owner=""
+  fi
+  # An empty owner in a lock that still exists is likewise unreadable. The
+  # second existence check preserves fail-closed behavior for that case while
+  # accepting a lock removed during the read above.
+  if [ -z "$owner" ] && [ -f "$lock" ]; then
+    printf 'unknown\n'
+    return 1
+  fi
diff --git a/tests/test_actas_lock.bats b/tests/test_actas_lock.bats
--- a/tests/test_actas_lock.bats
+++ b/tests/test_actas_lock.bats
@@ -133 +133,2 @@ live_pid() { echo "$$"; }
-  local rd="$(actas_lock_path "T" "alice").reclaim.d"
+  local rd
+  rd="$(actas_lock_path "T" "alice").reclaim.d"
@@ -247,0 +248,27 @@ live_pid() { echo "$$"; }
+
+@test "state: free when the lock disappears during an owner read" {
+  local lock_path
+  lock_path="$(actas_lock_path "T" "alice")"
+  printf '%s\n' sid-owner > "$lock_path"
+
+  # Model the watcher dropping the role between the state probe and owner read.
+  # The file is gone, so there is no unknown lock state left to protect.
+  actas_lock_owner() {
+    rm -f "$lock_path"
+    return 1
+  }
+
+  run actas_lock_state "T" "alice" "sid-me"
+  [ "$status" -eq 0 ]
+  [ "$output" = "free" ]
+}
+
+@test "state: unknown when a present lock has no readable owner" {
+  local lock_path
+  lock_path="$(actas_lock_path "T" "alice")"
+  : > "$lock_path"
+
+  run actas_lock_state "T" "alice" "sid-me"
+  [ "$status" -ne 0 ]
+  [ "$output" = "unknown" ]
+}
