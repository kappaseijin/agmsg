+      "alice|claude-code|/tmp/project-a-2") seen_alice_b=1 ;;
+      "bob|codex|/tmp/project-b") seen_bob=1 ;;
+      *) unexpected=1 ;;
+    esac
+  done < <(sqlite3 -batch -noheader :memory: \
+    "SELECT value FROM json_each('$(printf '%s' "$output" | sed "s/'/''/g")', '\$.registrations');")
+
+  [ "$unexpected" -eq 0 ]
+  [ "$seen_alice_a" -eq 1 ]
